<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      The Motorola test device exhausts Flutter SurfaceView buffers with the
      Vulkan Impeller backend in debug mode. Keep release/profile unchanged;
      this development-only fallback removes BLASTBufferQueue log flooding.
    -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
